{
  "name": "multi-chain-wallet-service",
  "version": "1.0.0",
  "description": "多链钱包微服务 - 支持BTC/ETH/BSC/TRX",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "ts-node src/database/migrate.ts",
    "generate-mnemonic": "ts-node src/scripts/generate-mnemonic.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "mysql2": "^3.6.5",
    "ethers": "^6.9.0",
    "tronweb": "^5.3.2",
    "bitcoinjs-lib": "^6.1.5",
    "ecpair": "^2.1.0",
    "tiny-secp256k1": "^2.2.3",
    "bip39": "^3.1.0",
    "bip32": "^4.0.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "uuid": "^9.0.1",
    "winston": "^3.11.0",
    "node-schedule": "^2.1.1",
    "crypto-js": "^4.2.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "@types/node": "^20.10.5",
    "@types/express": "^4.17.21",
    "@types/uuid": "^9.0.7",
    "@types/node-schedule": "^2.1.5",
    "@types/crypto-js": "^4.2.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
