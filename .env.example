# 服务配置
PORT=3000
NODE_ENV=development

# 数据库配置
DB_HOST=localhost
DB_PORT=3306
DB_USER=wallet_user
DB_PASSWORD=your_password
DB_NAME=wallet_db

# API密钥
ANKR_API_KEY=your_ankr_api_key
BLOCKCYPHER_TOKEN=your_blockcypher_token
TRONGRID_API_KEY=your_trongrid_api_key

# 加密密钥（用于助记词加密存储）
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# API认证
API_KEY=your_api_key
HMAC_SECRET=your_hmac_secret

# 热钱包地址（资金归集目标）
HOT_WALLET_BTC=your_btc_hot_wallet_address
HOT_WALLET_ETH=your_eth_hot_wallet_address
HOT_WALLET_BSC=your_bsc_hot_wallet_address
HOT_WALLET_TRX=your_trx_hot_wallet_address

# 回调URL（充值确认后通知）
CALLBACK_URL=http://your-backend/api/wallet/callback

# 区块确认数
BTC_CONFIRMATIONS=3
ETH_CONFIRMATIONS=12
BSC_CONFIRMATIONS=15
TRX_CONFIRMATIONS=20

# 轮询间隔（毫秒）
POLL_INTERVAL=30000
