{
  "name": "multi-chain-wallet-service",
  "version": "1.0.0",
  "description": "多链钱包微服务 - 支持BTC/ETH/BSC/TRX",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "migrate": "ts-node src/database/migrate.ts",
    "generate-mnemonic": "ts-node src/scripts/generate-mnemonic.ts",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit --coverage",
    "test:integration": "jest tests/integration --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "axios": "^1.6.2",
    "better-sqlite3": "^12.5.0",
    "bip32": "^4.0.0",
    "bip39": "^3.1.0",
    "bitcoinjs-lib": "^6.1.5",
    "crypto-js": "^4.2.0",
    "dotenv": "^16.3.1",
    "ecpair": "^2.1.0",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "mysql2": "^3.6.5",
    "node-schedule": "^2.1.1",
    "tiny-secp256k1": "^2.2.3",
    "tronweb": "^5.3.2",
    "uuid": "^9.0.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.10.5",
    "@types/node-schedule": "^2.1.5",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
